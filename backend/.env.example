# ============================================================
# Backend — Variables d'environnement
# Copiez ce fichier : cp .env.example .env
# Puis remplissez les valeurs
# ============================================================

# --- Base de données ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="strategie_sante"

# --- URL publique du site (emails, SEO, sitemap, QR codes) ---
SITE_URL=https://votre-domaine.fr

# --- CORS (origines autorisées, séparées par virgule) ---
CORS_ORIGINS="*"
ALLOWED_ORIGINS=https://votre-domaine.fr,http://localhost:3000

# --- JWT (générez une clé secrète unique) ---
JWT_SECRET=CHANGEZ_MOI_clé_secrète_jwt_32_chars_minimum

# --- Intelligence Artificielle ---
# Option A : Clé Emergent (si hébergé sur Emergent)
# EMERGENT_LLM_KEY=votre_clé_emergent
# Option B : SDK Anthropic natif (si autonome)
# ANTHROPIC_API_KEY=sk-ant-...

# --- Paiements Stripe ---
STRIPE_API_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_DOSSIER_EXPRESS=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Paiements PayPal ---
PAYPAL_CLIENT_ID=votre_client_id
PAYPAL_CLIENT_SECRET=votre_secret
PAYPAL_MODE=sandbox

# --- Email (Resend) ---
RESEND_API_KEY=re_...
SENDER_EMAIL=contact@votre-domaine.fr
NOTIFICATION_EMAIL=admin@votre-domaine.fr

# --- Recherche (Algolia) ---
ALGOLIA_APP_ID=votre_app_id
ALGOLIA_API_KEY=votre_api_key
ALGOLIA_INDEX_NAME=strategie_sante

# --- Stockage fichiers ---
# Option A : Emergent Object Storage (si hébergé sur Emergent)
# STORAGE_URL=https://integrations.emergentagent.com
# Option B : AWS S3 (si autonome)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=votre-bucket
# AWS_REGION=eu-west-3

# --- Push Notifications (optionnel) ---
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
