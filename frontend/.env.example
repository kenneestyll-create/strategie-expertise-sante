# ============================================================
# Frontend — Variables d'environnement
# Copiez ce fichier : cp .env.example .env
# Puis remplissez les valeurs
# ============================================================

# --- URL de l'API backend (avec /api prefix) ---
REACT_APP_BACKEND_URL=https://votre-domaine.fr

# --- URL publique du site (SEO, canonical, OpenGraph) ---
REACT_APP_SITE_URL=https://votre-domaine.fr

# --- Paiements Stripe (clé publique) ---
REACT_APP_STRIPE_KEY=pk_test_...

# --- PayPal (client ID) ---
REACT_APP_PAYPAL_CLIENT_ID=votre_client_id

# --- Recherche (Algolia — clés publiques uniquement) ---
REACT_APP_ALGOLIA_APP_ID=votre_app_id
REACT_APP_ALGOLIA_SEARCH_KEY=votre_search_key
REACT_APP_ALGOLIA_INDEX_NAME=strategie_sante
