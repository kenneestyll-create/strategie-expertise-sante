# ====================================
# Stratégie & Expertise Santé — .gitignore
# ====================================

# IDE
.idea/
.vscode/

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Builds
/build
dist/
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Environment (NEVER commit secrets)
*.env
*.env.*
!*.env.example

# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dump.rdb

# System
.DS_Store
*.pem
Thumbs.db

# Testing / Coverage
/coverage
.pytest_cache/
.ruff_cache/

# Emergent platform (dev only)
.emergent/
.screenshots/
test_reports/
test_result.md
backend_test.py
AUDIT_COMPLET.md

# Archives
*.zip
*.tar.gz
*.tar
*.tgz
*.pack
*.deb

# Caches
.cache/

# Test credentials (NEVER commit)
test_credentials.md
memory/test_credentials.md
frontend/node_modules/.cache/default-development/10.pack
frontend/node_modules/.cache/default-development/36.pack
frontend/node_modules/.cache/default-development/81.pack
.env
.env.*
credentials.json
*.key
.credentials
